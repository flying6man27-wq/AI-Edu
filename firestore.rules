rules_version = '2';

// ══════════════════════════════════════════════════════════════
// AI 역량강화 시스템(ai-edu-seco) Firestore 보안 규칙  [하드닝 v2]
//   변경 요지(2026-06-06):
//   ▸ read  : if true → 인증 필요(signedIn). 익명 전량조회(개인정보 노출) 차단.
//   ▸ delete: if true → 관리자(admin)만. 외부 삭제 차단.
//   ▸ create/update: 학습포털·추천폼 기록이 끊기지 않도록 유지(차기: 익명인증+검증으로 추가 강화).
//   배포: 이 파일 저장 후  firebase deploy --only firestore:rules
//
//   변경 요지(2026-10-20): 익명 로그인(학습·온보딩 포털)도 signedIn() 을 통과하므로 위 'read: signedIn()'
//   은 실제로는 전량조회를 막지 못했다. 목록 조회(list)·쿼리·구독은 관리자·열람 계정(viewer)·동기화 전용 계정(syncBot)만 허용하고,
//   포털이 쓰는 문서 1건 조회(get)와 create/update 는 그대로 둔다.
//   ※ 이 파일은 deploy-hosting 워크플로로 배포되지 않는다. 배포 전 Rules Playground 로 아래를 확인할 것:
//     ① 익명 로그인으로 learners 목록 조회 → 거부  ② 익명으로 learners/{본인uid} 1건 조회 → 허용
//     ③ 관리자·열람 계정으로 learners 목록 조회 → 허용
// ══════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 관리자 UID(대시보드 ADMIN_UID). 커스텀클레임 쓰면 request.auth.token.admin == true 로 교체.
    function admin() { return signedIn() && request.auth.uid == 'VBqsJ1lPrmNiVzvKB60X4XPtOF23'; }

    // 임원 열람 계정 — 대시보드(public/index.html)의 VIEWER_EMAILS 와 반드시 같은 목록으로 유지한다.
    //   익명 로그인(학습 포털)은 request.auth 가 있어 signedIn() 을 통과하므로, '목록 조회'는
    //   로그인 방식(password)까지 확인해 익명 사용자를 배제한다. 한 명 추가 = 여기 + VIEWER_EMAILS 둘 다.
    function viewer() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.lower() in [
             'slee@investorunited.co.kr',
             'yeyoon@investorunited.co.kr'
           ];
    }
    // 동기화 전용 읽기 계정 — people-hub 일일 사이클(edu_sync·edu_parity_check)이 Firestore 를 읽는다.
    //   이전에는 익명 로그인으로 컬렉션 전체를 읽었으므로, 이 계정을 만들고 스크립트를 전환한 뒤에 규칙을 배포해야 한다
    //   (순서가 바뀌면 교육 파이프라인이 PERMISSION_DENIED 로 멈춘다). 이메일은 Firebase Auth 에 '사용자 추가'로 만든 값과 같아야 한다.
    function syncBot() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.lower() == 'edu-sync@investorunited.co.kr';
    }
    // 목록(list)·쿼리·실시간 구독은 관리자·열람 계정·동기화 계정만. 문서 1건 조회(get)는 학습 포털의 진도 복원용으로 유지.
    function canList() { return admin() || viewer() || syncBot(); }

    // 학습자 등록·진도 — 읽기는 인증 필요, 삭제는 관리자만
    //   (2026-09-15 되돌림) `admin() || auth.uid==docId` 조건이 실제로는 항상 거짓이었다.
    //   포털이 문서ID로 쓰는 값(makeUid(email), 이메일 해시)과 익명 로그인의
    //   실제 auth.uid(랜덤값)가 절대 같을 수 없어, 2026-08 강화 이후 모든 학습자의
    //   진도 저장이 실측으로 확인된 채 조용히 실패하고 있었다(uid==docId 위조 방지
    //   의도였지만 정상 사용자까지 막음). champion_nominees/offline_attendance와
    //   같은 수준(signedIn() 요구, 위조 방지는 안 됨)으로 되돌려 저장을 복구한다.
    match /learners/{docId} {
      allow get:            if signedIn();   // 문서 1건 조회 — 포털이 본인 진도를 복원할 때 사용
      allow list:           if canList();    // ★ 전량 목록 조회는 관리자·열람 계정만(익명 로그인 차단)
      allow create, update: if signedIn();    // ★ 무인증 저장만 차단(문서ID 소유권 검증은 안 함)
      allow delete:         if admin();       // ★ 삭제 관리자만
    }

    // 신규입사자 온보딩 자가학습(OB01~OB06) — learners와 동일 정책, 컬렉션만 분리
    //   ※ AI역량강화 통계(분모 15개 모듈)가 오염되지 않도록 별도 컬렉션 사용
    //   온보딩 포털도 onboarding_learners/{user.uid} 에 쓴다(문서ID=uid).
    //   (2026-09-15 되돌림) learners와 동일한 사유로 uid==docId 조건 제거.
    match /onboarding_learners/{docId} {
      allow get:            if signedIn();   // 문서 1건 조회 — 포털이 본인 진도를 복원할 때 사용
      allow list:           if canList();    // ★ 전량 목록 조회는 관리자·열람 계정만(익명 로그인 차단)
      allow create, update: if signedIn();    // ★ 무인증 저장만 차단(문서ID 소유권 검증은 안 함)
      allow delete:         if admin();       // ★ 삭제 관리자만
    }

    // AI챔피언 후보 추천 — 읽기 인증, 수정 관리자, 삭제 차단
    //   (2026-08 강화) create가 `if true` 였다. 추천폼은 .add()로 자동ID를 쓰므로
    //   uid 스코프를 걸 수 없다. 대신 인증을 요구해 무인증 대량 등록을 막는다.
    match /champion_nominees/{docId} {
      allow read:   if canList();             // ★ 후보 명단 조회는 관리자·열람 계정만(추천폼은 create만 사용)
      allow create: if signedIn();            // ★ 무인증 제출 차단
      allow update: if admin();
      allow delete: if false;
    }

    // 오프라인 교육 출석 — 읽기 인증, 수정 관리자, 삭제 차단
    //   (2026-08 강화) create가 `if true` 였다. 출석은 이수 인정 근거이므로
    //   무인증 등록을 막는다.
    match /offline_attendance/{docId} {
      allow read:   if canList();             // ★ 출석명단 조회는 관리자·열람 계정만
      allow create: if signedIn();            // ★ 무인증 출석기록 차단
      allow update: if admin();
      allow delete: if false;
    }

    // ops_snapshots — 일자별 집계 추이(개인정보 없음). 관리자만 읽기/쓰기.
    match /ops_snapshots/{docId} {
      allow read, write: if admin();
    }

    // 공개 집계 — 대표 보고서(report.html) 실시간 연동용
    //   개인정보(이름·이메일) 미포함, 그룹·관계사별 '집계 수치'만 저장.
    //   읽기는 공개(로그인 불필요), 쓰기(발행)는 관리자만.
    match /public_stats/{docId} {
      allow read:  if true;     // 집계만 공개 — PII 없음
      allow write: if admin();  // ★ 발행은 관리자(대시보드)만
    }

    // 관계사 레지스트리(이름·목표인원) — PII 없음. 관리자 대시보드 전용 CRUD.
    //   (2026-09-15 발견) 규칙이 아예 없어 "그 외 모든 경로는 기본 거부"에 걸려
    //   관리자 로그인 상태에서도 조회·저장이 전부 PERMISSION_DENIED 였다.
    match /companies/{docId} {
      allow read, write: if admin();
    }

    // 교육 만족도 설문(신규입사자 통합교육 등) — 응답자별 일회용 토큰(문서ID 12자리)으로 1회 제출.
    //   (2026-10-21) 생성만 허용(수정·삭제 불가 → 중복 제출·덮어쓰기 차단), 읽기는 관리자만.
    //   필드·점수 범위를 검증해 임의 데이터 주입을 막는다. 성명은 저장하지 않는다.
    match /onboarding_survey/{docId} {
      allow read: if admin();
      allow create: if signedIn()
        && docId.matches('[A-Za-z0-9]{12}')
        && request.resource.data.keys().hasOnly(['survey','intro','growth','vision','comm','ai','overall','recommend','comment','submittedAt'])
        && request.resource.data.keys().hasAll(['survey','intro','growth','vision','comm','ai','overall','recommend','submittedAt'])
        && request.resource.data.survey is string && request.resource.data.survey.size() <= 12
        && request.resource.data.intro is int && request.resource.data.intro >= 1 && request.resource.data.intro <= 5
        && request.resource.data.growth is int && request.resource.data.growth >= 1 && request.resource.data.growth <= 5
        && request.resource.data.vision is int && request.resource.data.vision >= 1 && request.resource.data.vision <= 5
        && request.resource.data.comm is int && request.resource.data.comm >= 1 && request.resource.data.comm <= 5
        && request.resource.data.ai is int && request.resource.data.ai >= 1 && request.resource.data.ai <= 5
        && request.resource.data.overall is int && request.resource.data.overall >= 1 && request.resource.data.overall <= 5
        && request.resource.data.recommend in ['적극 추천','추천','보통','추천 안 함']
        && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 500))
        && request.resource.data.submittedAt == request.time;
      allow update: if false;
      allow delete: if admin();
    }

    // 열람 키 보관 — 대시보드의 참석자 명단 복호화 키(secure_config/roster.k). 사람 계정(관리자·열람)만 읽고 관리자만 쓴다.
    //   동기화 계정(syncBot)은 명단이 필요 없으므로 일부러 제외했다.
    match /secure_config/{docId} {
      allow read:  if admin() || viewer();
      allow write: if admin();
    }

    // 그 외 모든 경로는 기본 거부
  }
}
